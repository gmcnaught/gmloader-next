# Makefile.fabric_soak — standalone armhf cross-build of the fabric RTL soak harness.
#
# Same shape as Makefile.fabric_probe: links tools/fabric_soak.c against the vendored
# 3rdparty/mfgpu HOST emitter only (blt_emitter.c/blt_alloc.c). The harness talks to
# the real DDR ring, never to a software oracle, so refmodel/*.c and libmfgpu/*.c are
# not needed to link it.
#
# Build (from the gmloader-next repo root, same image as Dockerfile.gmloader-build):
#   docker run --rm -v "$PWD:/src" -w /src gmloader-armhf-build:bullseye \
#       make -f tools/Makefile.fabric_soak
# Output: tools/fabric_soak.armhf
#
# Run on device WITH THE ENGINE DISABLED so nothing else drives the fabric:
#   touch /media/fat/games/gmloader/NOENGINE   (then reload the core)
#   /tmp/fabric_soak.armhf --secs=120
#   rm /media/fat/games/gmloader/NOENGINE      (restore normal launches)

ARCH  ?= arm-linux-gnueabihf
CROSS ?= $(ARCH)-
CC    := $(CROSS)gcc

MFGPU_DIR := 3rdparty/mfgpu
MFGPU_INC := -I$(MFGPU_DIR)/host -I$(MFGPU_DIR)/refmodel

# gnu11 (not strict c11): needs POSIX clock_gettime/CLOCK_MONOTONIC + mmap/open, which
# -std=c11 hides behind glibc's __STRICT_ANSI__ gate. Same rationale as fabric_probe.
CFLAGS ?= -O2 -std=gnu11 -Wall -Wextra $(MFGPU_INC)
ifeq ($(ARCH),arm-linux-gnueabihf)
CFLAGS += -mtune=cortex-a9
endif

SRCS := tools/fabric_soak.c \
        $(MFGPU_DIR)/host/blt_emitter.c \
        $(MFGPU_DIR)/host/blt_alloc.c
OUT  := tools/fabric_soak.armhf

.PHONY: all clean
all: $(OUT)

$(OUT): $(SRCS)
	$(CC) $(CFLAGS) -o $@ $(SRCS)

clean:
	rm -f $(OUT)
