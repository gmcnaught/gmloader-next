ARCH ?= aarch64-linux-gnu
CROSS ?= ${ARCH}-
CC := ${CROSS}gcc
CXX := ${CROSS}g++
LD := ${CROSS}ld
PKG_CONFIG := ${CROSS}pkg-config
STATIC_LIBSTDCXX ?= 0

BUILD_DATE = $(shell date +"%Y%m%d_%H%M%S")
GIT_BRANCH = ${GITHUB_REF_NAME}
GIT_BRANCH_FRIENDLY = $(subst -,_,$(GIT_BRANCH))

DEVICE_ARCH = aarch64

ifeq ($(ARCH), arm-linux-gnueabihf)
	DEVICE_ARCH = armhf
endif

LIBS:=\
	-pthread \
	-lm \
	-lrt \
	-ldl \
	$(shell ${PKG_CONFIG} sdl2 --libs) \
	$(shell ${PKG_CONFIG} zlib --libs)

MFGPU_DIR := 3rdparty/mfgpu
MFGPU_SRC := $(MFGPU_DIR)/refmodel/blitter_ref.c $(MFGPU_DIR)/refmodel/blt_tri.c \
             $(MFGPU_DIR)/host/blt_emitter.c $(MFGPU_DIR)/host/blt_alloc.c \
             $(MFGPU_DIR)/libmfgpu/mfgpu.c $(MFGPU_DIR)/libmfgpu/mfgpu_xform.c
MFGPU_INC := -I$(MFGPU_DIR)/libmfgpu -I$(MFGPU_DIR)/host -I$(MFGPU_DIR)/refmodel

# General compilation flags
OPTM?=-O2 -ggdb
COMMONFLAGS:=-Wno-strict-aliasing -Werror=return-type -I. -I./thunks/ -I./loader/ -I./gmloader/ -I./build/${ARCH}/thunks/libc -I./jni/ -I./3rdparty/json/include -I./3rdparty/stb -I./3rdparty/lua -I./3rdparty/libzip/lib -I./3rdparty/libzip-config ${MFGPU_INC} ${OPTM} -MMD
CFLAGS:=$(shell ${PKG_CONFIG} sdl2 --cflags) ${COMMONFLAGS}
CXXFLAGS:=-std=gnu++2a -fuse-cxa-atexit $(shell ${PKG_CONFIG} sdl2 --cflags) ${COMMONFLAGS}

ifeq ($(DEVICE_ARCH), armhf)
# Tune instruction scheduling for the DE10-Nano's Cortex-A9 (in-order, dual-issue).
# -mtune only affects scheduling (no ISA/ABI change), so it is safe tree-wide.
CFLAGS   += -mtune=cortex-a9
CXXFLAGS += -mtune=cortex-a9
# .ARM.exidx unwind tables so the SIGABRT/SIGSEGV crash handler's backtrace()
# can walk through C frames too (C++ gets them anyway via exceptions). Costs
# binary size only — no codegen change on the hot paths.
CFLAGS   += -funwind-tables
CXXFLAGS += -funwind-tables

# Opt-in AddressSanitizer build (ASAN=1) for hunting the intermittent glibc
# heap corruption. -static-libasan because the MiSTer rootfs has no libasan.so.
# The game's own libyoyo.so is NOT instrumented (gmloader hand-loads it), so an
# out-of-bounds write from game code is caught at free/realloc via redzone
# checks rather than at the store; a bad write from gmloader's own code IS
# trapped exactly where it happens. Requires a full rebuild — the flags change
# codegen, and make will not rebuild unchanged sources on its own.
ifeq ($(ASAN),1)
ASAN_FLAGS := -fsanitize=address -fno-omit-frame-pointer -static-libasan
CFLAGS   += $(ASAN_FLAGS)
CXXFLAGS += $(ASAN_FLAGS)
# NOTE: LDFLAGS is assigned with := further down, so the link-side flags are
# appended AFTER that assignment (see the second ASAN block) — appending here
# would be silently wiped.
endif
# Enable NEON only for the software blitter's rasterizer, so its vectorized inner
# loop is active without changing the ISA for the rest of the tree (loader
# trampolines / thunks).
build/${ARCH}/gmloader/mister/blitter_raster.cpp.o: CXXFLAGS += -march=armv7-a -mfpu=neon-vfpv3
endif
LDFLAGS:=${OPTM} -Wl,--gc-sections -Wl,--defsym,BUILD_DATE_$(BUILD_DATE)=0 -Wl,--defsym,GIT_HASH_$(GITHUB_SHA)=0 -Wl,--defsym,GIT_BRANCH_$(GIT_BRANCH_FRIENDLY)=0
# ASAN link flags — must come after the := above (see the ASAN block near the
# compile flags). --gc-sections is kept; libasan is linked statically.
ifeq ($(ASAN),1)
LDFLAGS += $(ASAN_FLAGS)
endif

# General pre-processing flags
LLVM_FILE?=
LLVM_INC?=/usr/${ARCH}/include
LLVM_SYSROOT?=

GENERATE?=

ifneq (${LLVM_SYSROOT},)
	GENERATE+=--llvm-sysroot="${LLVM_SYSROOT}"
endif

ifneq (${LLVM_FILE},)
	GENERATE+=--llvm-library-file="${LLVM_FILE}"
endif

GENERATE+=--llvm-includes ${LLVM_INC}

ifeq (${DEVICE_ARCH},aarch64)
	FMOD_ARCH=arm64
else ifeq (${DEVICE_ARCH},armhf)
	FMOD_ARCH=armhf
endif

ifeq (${USE_FMOD},1)
	CFLAGS+=-DUSE_FMOD=1 -I./3rdparty/fmod/api/core/inc -I./3rdparty/fmod/api/studio/inc
	CXXFLAGS+=-DUSE_FMOD=1 -I./3rdparty/fmod/api/core/inc -I./3rdparty/fmod/api/studio/inc

	LIBS+=-L./3rdparty/fmod/api/core/lib/${FMOD_ARCH} -L./3rdparty/fmod/api/studio/lib/${FMOD_ARCH} -lfmod -lfmodstudio
	-include 3rdparty/FMOD_SDL.mk
endif

ifeq (${USE_LUA},1)
	CFLAGS+=-DUSE_LUA=1
	-include 3rdparty/lua.mk
endif

ifeq (${VIDEO_SUPPORT},1)
	CFLAGS+=-DVIDEO_SUPPORT=1 -I./3rdparty/SDL_kitchensink/include
	LIBS+=-lavcodec -lavformat -lswresample -lswscale -lavutil
	-include 3rdparty/SDL_kitchensink.mk
endif

ifeq (${STATIC_LIBSTDCXX},1)
	LIBS+=-static-libstdc++
endif

MISTER_BUILD ?= 0

ifeq ($(MISTER_BUILD),1)
CFLAGS   += -DMISTER_NATIVE_VIDEO=1 -DMISTER_WIDTH=288 -DMISTER_HEIGHT=216
CXXFLAGS += -DMISTER_NATIVE_VIDEO=1 -DMISTER_WIDTH=288 -DMISTER_HEIGHT=216
LDFLAGS  += -L$(CURDIR)/3rdparty/gles2-sw -lGLES_sw -Wl,-rpath,'$$ORIGIN'
MISTER_SRCS = gmloader/mister/native_video_writer.c gmloader/mister/native_audio_writer.c gmloader/mister/mister_native_audio.cpp gmloader/mister/frame_capture.cpp gmloader/mister/draw_trace.cpp gmloader/mister/blitter.cpp gmloader/mister/blitter_raster.cpp gmloader/mister/raster_backend_sw.cpp gmloader/mister/raster_backend_mfgpu.cpp gmloader/mister/joy_shm_reader.cpp gmloader/mister/joy_ddr_reader.cpp gmloader/mister/bench_godmode.cpp gmloader/mister/bench_godmode_core.c
endif

# Used by generate_libc.py to generate the function tables that are exported to the
# application.
LIBC_SRCS=$(filter-out $(if ${exclude_file1},,thunks/libc/libc_table.cpp),$(wildcard thunks/libc/*.cpp))
LIBC_TABS=build/${ARCH}/thunks/libc/impl_header.h build/${ARCH}/thunks/libc/impl_tab.h

# Files that are compiled into your loader
LOADER_OBJS=$(patsubst %.cpp,build/%.cpp.o,$(wildcard loader/*.cpp))
THUNK_OBJS=$(patsubst %.cpp,build/%.cpp.o,$(wildcard thunks/*/*.cpp))
JNI_OBJS:=$(patsubst %.cpp,build/%.cpp.o,$(wildcard jni/classes/*.cpp))
JNI_OBJS+=$(patsubst %.cpp,build/%.cpp.o,$(wildcard jni/*.cpp))
GMLOADER_OBJS:=$(patsubst %.cpp,build/%.cpp.o,$(wildcard gmloader/*.cpp))
GMLOADER_OBJS+=$(patsubst %.cpp,build/%.cpp.o,$(wildcard gmloader/classes/*.cpp))
GMLOADER_OBJS+=$(patsubst %.cpp,build/%.cpp.o,$(wildcard gmloader/stubs/*.cpp))
MFGPU_OBJS:=$(patsubst %.c,build/%.c.o,$(MFGPU_SRC))

ifeq ($(MISTER_BUILD),1)
MISTER_OBJS:=$(patsubst %.cpp,build/%.cpp.o,$(filter %.cpp,$(MISTER_SRCS)))
MISTER_OBJS+=$(patsubst %.c,build/%.c.o,$(filter %.c,$(MISTER_SRCS)))
endif

GENERIC_OBJ:=\
	${LOADER_OBJS} \
	${THUNK_OBJS} \
	${JNI_OBJS} \
	${GMLOADER_OBJS} \
	${MFGPU_OBJS} \
	${MISTER_OBJS}

OBJ=$(patsubst build/%,build/${ARCH}/%,${GENERIC_OBJ})

all: build/${ARCH}/gmloader/gmloadernext.${DEVICE_ARCH}

clean:
	rm -rf build/${ARCH}

# Include subprojects for 3rdparty libraries and their relevant flags
-include 3rdparty/libbsd.mk
-include 3rdparty/libzip.mk

# By repeating the generated headers on this rule, we force them to start building
# as soon as possible, so libc_table.cpp isn't waiting forever.
build/${ARCH}/gmloader/gmloadernext.${DEVICE_ARCH}: ${LIBC_TABS} $(BSD_OBJ) $(LUA_OBJ) $(ZIP_OBJ) $(FMODSDL_OBJ) $(KIT_OBJ) $(OBJ)
	$(CXX) $(LDFLAGS) -o $@ $(OBJ) $(LUA_OBJ) $(ZIP_OBJ) $(FMODSDL_OBJ) $(KIT_OBJ) $(BSD_OBJ) $(LIBS)

# Every object depends on THIS makefile. Geometry (MISTER_WIDTH/HEIGHT) and the other
# feature switches arrive as -D flags, not as anything -MMD can see, so without this
# prerequisite a flag-only change leaves every existing .o looking current: make rebuilds
# nothing and you link a binary whose translation units disagree about the geometry. That
# actually shipped once (2026-07-27) — a day-old main.cpp.o logged `pbuffer 320x240` beside
# freshly-built 288x216 objects, and md5 verification could not see it because md5 proves
# transport, not build coherence. It also silently defeats the
# static_assert(MISTER_WIDTH == BLT_FB_WIDTH) in raster_backend_mfgpu.cpp, which can only
# fire if its object is actually recompiled.
build/${ARCH}/%.cpp.o: %.cpp Makefile.gmloader
	@mkdir -p $(@D)
	$(CXX) $(CXXFLAGS) $(BSD_FLAGS) $(MD_FLAGS) -c $< -o $@

build/${ARCH}/%.c.o: %.c Makefile.gmloader
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) $(MD_FLAGS) -c $< -o $@

# The libc_table.cpp symbol table depends on the generated headers
%/libc_table.cpp: ${LIBC_TABS};

# The generated headers depend on the libc sources
${LIBC_TABS} &: ${LIBC_SRCS} thunks/libc/symtab thunks/libc/symtab_exclude thunks/libc/c_prototypes.h thunks/libc/common.hpp
	@mkdir -p $(@D)
	python3 scripts/generate_libc.py ${ARCH} ${GENERATE}

# Include all build dependencies too
-include $(OBJ:%.o=%.d)

# ---- host-side unit tests (no ARM cross-compile needed) --------------------
.PHONY: raster-backend-test
raster-backend-test:
	c++ -std=c++17 -Igmloader/mister $(MFGPU_INC) \
	  gmloader/mister/raster_backend_test.cpp \
	  gmloader/mister/raster_backend_sw.cpp \
	  gmloader/mister/raster_backend_mfgpu.cpp \
	  gmloader/mister/blitter_raster.cpp \
	  $(MFGPU_SRC) \
	  -lm -o /tmp/rbt && /tmp/rbt

# Task 4 (app-surface BRAM render-target plan): drives blitter.cpp's real
# GL-shadow hooks (unlike raster-backend-test, which stays below that layer),
# so it needs blitter.cpp itself, its GL type header (glad.h -- see the
# vendored thunks/khronos/KHR/khrplatform.h it needs), and configuration.cpp
# (gmloader_config, extern'd by blitter.cpp).
.PHONY: mf-cov-clip-test
# TDD host test for the covered-pixel estimator's triangle-vs-render-target
# clipping (mf_clip_tri_area in raster_backend_mfgpu.cpp). Same link set as
# raster-backend-test (the function lives in that translation unit and needs
# its full dependency chain), swapping in mf_cov_clip_test.cpp as the driver.
mf-cov-clip-test:
	c++ -std=c++17 -Igmloader/mister $(MFGPU_INC) \
	  gmloader/mister/mf_cov_clip_test.cpp \
	  gmloader/mister/raster_backend_sw.cpp \
	  gmloader/mister/raster_backend_mfgpu.cpp \
	  gmloader/mister/blitter_raster.cpp \
	  $(MFGPU_SRC) \
	  -lm -o /tmp/mcct && /tmp/mcct

.PHONY: mf-seam-stat-test
# TDD host test for the Phase 4 Stage A submit-seam accumulator (mf_seam_stat.h).
# The header is deliberately dependency-free, so unlike raster-backend-test this
# needs no other translation unit and no MFGPU sources.
mf-seam-stat-test:
	c++ -std=c++17 -Igmloader/mister \
	  gmloader/mister/mf_seam_stat_test.cpp \
	  -lm -o /tmp/mfss && /tmp/mfss

.PHONY: mf-pending-clear-test
# TDD host test for the Phase 4 Stage B deferred full-screen clear
# (mf_pending_clear.h). Like mf-seam-stat-test the header is dependency-free,
# so this needs no other translation unit and no MFGPU sources.
mf-pending-clear-test:
	c++ -std=c++17 -Igmloader/mister \
	  gmloader/mister/mf_pending_clear_test.cpp \
	  -lm -o /tmp/mfpc && /tmp/mfpc

.PHONY: blitter-appsurf-test
blitter-appsurf-test:
	c++ -std=c++17 -DMISTER_NATIVE_VIDEO=1 -Igmloader/mister -Igmloader -I. \
	  -Ithunks/khronos -Iloader -I3rdparty/json/include $(MFGPU_INC) \
	  gmloader/mister/blitter_appsurf_test.cpp \
	  gmloader/mister/blitter.cpp \
	  gmloader/mister/blitter_raster.cpp \
	  gmloader/mister/raster_backend_sw.cpp \
	  gmloader/mister/raster_backend_mfgpu.cpp \
	  gmloader/configuration.cpp \
	  $(MFGPU_SRC) \
	  -lm -o /tmp/bat && /tmp/bat
.PHONY: strl-test
# Host-native test for the bionic strlcpy/strlcat thunks. Links the REAL
# stdio.cpp (ABI_ATTR is empty off-ARM) so it exercises shipped code, and uses
# canary bytes to catch writes past the destination buffer.
strl-test:
	c++ -std=c++17 -O0 -g -I. -Iloader -Ithunks -Ithunks/libc -Ijni \
	  -I3rdparty/libbsd/include -I3rdparty/libbsd-config -I3rdparty/libbsd/include/bsd \
	  -DLIBBSD_OVERLAY -DLIBBSD_DISABLE_DEPRECATED -D__REENTRANT \
	  thunks/libc/stdio.cpp tests/strl_test.cpp \
	  -o /tmp/strl && /tmp/strl

.PHONY: joy-shm-test
joy-shm-test:
	c++ -std=c++17 -DMISTER_NATIVE_VIDEO=1 -Igmloader/mister -Igmloader -I. \
	  gmloader/mister/joy_shm_reader_test.cpp \
	  gmloader/mister/joy_shm_reader.cpp \
	  gmloader/mister/joy_ddr_reader.cpp \
	  -lm -o /tmp/jst && /tmp/jst

.PHONY: native-audio-writer-test
native-audio-writer-test:
	cc -std=c11 -O0 -g -Igmloader/mister \
	  gmloader/mister/native_audio_writer_test.c \
	  gmloader/mister/native_audio_writer.c \
	  -o /tmp/nawt && /tmp/nawt

.PHONY: fps-overlay-test
fps-overlay-test:
	cc -std=c11 -Wall -Wextra -O2 -Igmloader/mister \
	  gmloader/mister/fps_overlay_test.c \
	  -o /tmp/fpsov && /tmp/fpsov

.PHONY: bench-godmode-test
bench-godmode-test:
	cc -std=c11 -Wall -Wextra -O2 -Igmloader/mister \
	  gmloader/mister/bench_godmode_test.c \
	  gmloader/mister/bench_godmode_core.c \
	  -o /tmp/bgt && /tmp/bgt

.PHONY: joy-script-test
joy-script-test:
	cc -std=c11 -O0 -g -Itools \
	  tools/joy_script_parse_test.c \
	  tools/joy_script_parse.c \
	  -o /tmp/jspt && /tmp/jspt

.PHONY: native-audio-shim-test
native-audio-shim-test:
	c++ -std=c++17 -O0 -g -Igmloader/mister $(shell pkg-config sdl2 --cflags) \
	  gmloader/mister/mister_native_audio_test.cpp \
	  gmloader/mister/mister_native_audio.cpp \
	  gmloader/mister/native_audio_writer.c \
	  $(shell pkg-config sdl2 --libs) -o /tmp/mnat && /tmp/mnat
